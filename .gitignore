# Git Ignore Rules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project specific
*.log
.cache/
tmp/
temp/

# Credentials (NEVER commit)
.env
.git-credentials
*.token
*.key
secrets/

# QwenPaw internal
memory/
sessions/
config/
